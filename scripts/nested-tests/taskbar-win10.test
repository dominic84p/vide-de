# Windoze 10 taskbar details: the search box's 1px edge, stacked cards on a grouped button
# (no count badge), the 24px tray with a ^ chevron whose grid holds apps' tray icons, and the
# show-desktop sliver's divider. Check the shots by eye.
wait 3
run nm-applet --indicator
run exec ./target/release/vide-about
expect-window vide-about 20
run exec ./target/release/vide-about
run exec ./target/release/vide-about
wait 4
shot 1-taskbar
click 1063 780
wait 1
shot 2-overflow
key esc
wait 0.5
shot 3-closed
