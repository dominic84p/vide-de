[Icon Theme]
Name=VIDE
Comment=VIDE-DE's own icons: folders, file types, our apps and toolbar glyphs
Inherits=breeze,hicolor
Directories=scalable/places,scalable/devices,scalable/mimetypes,scalable/apps,scalable/actions

[scalable/places]
Size=256
MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/devices]
Size=256
MinSize=8
MaxSize=512
Type=Scalable
Context=Devices

[scalable/mimetypes]
Size=256
MinSize=8
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/apps]
Size=256
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[scalable/actions]
Size=256
MinSize=8
MaxSize=512
Type=Scalable
Context=Actions
